{
  "name": "floor21-e2e",
  "private": true,
  "description": "Playwright UI tests for Floor21 (runs against a live Spring Boot instance)",
  "scripts": {
    "test": "playwright test tests/floor21-full-flow.spec.ts --workers=1",
    "test:ui": "playwright test --ui tests/floor21-full-flow.spec.ts --workers=1",
    "test:headed": "playwright test tests/floor21-full-flow.spec.ts --headed --workers=1",
    "test:debug": "playwright test --debug",
    "codegen": "playwright codegen",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
