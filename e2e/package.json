{
  "name": "floor21-e2e",
  "private": true,
  "description": "Playwright UI tests for Floor21 (runs against a live Spring Boot instance)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed --workers=1",
    "test:headed:slow": "playwright test --headed --config=playwright.slow.config.ts",
    "test:headed:slower": "playwright test --headed --config=playwright.slower.config.ts",
    "test:headed:watch": "playwright test --headed --config=playwright.watch.config.ts",
    "test:debug": "playwright test --debug",
    "codegen": "playwright codegen",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
